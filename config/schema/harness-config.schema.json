{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Performance Testing Harness Config",
  "type": "object",
  "required": ["target", "scenarios"],
  "properties": {
    "totalVus": { "type": "number" }, 
    "target": {
      "type": "object",
      "required": ["baseUrl"],
      "properties": {
        "baseUrl": { "type": "string" }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "tokenEnvVar": { "type": "string" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "endpoint", "trafficShape"],
        "properties": {
          "name": { "type": "string" },
          "endpoint": { "type": "string" },
          "weight": { "type": "number" },
          "method": { "type": "string", "default": "GET" },
          "payload": { "type": ["object", "string", "null"] },
          "trafficShape": {
            "type": "string",
            "enum": ["smoke", "ramp-up", "stress", "spike", "soak"]
          },
          "options": {
            "type": "object",
            "properties": {
              "vus": { "type": "number" },
              "duration": { "type": "string" },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["duration", "target"],
                  "properties": {
                    "duration": { "type": "string" },
                    "target": { "type": "number" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "thresholds":{
      "type": "object",
      "properties": {
        "max_p95_latency_ms": { "type": "number" },
        "max_error_rate_percent": { "type": "number" }
      }
    }
  }
}