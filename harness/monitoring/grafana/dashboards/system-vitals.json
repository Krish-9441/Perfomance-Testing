{
  "title": "System Vitals",
  "tags": ["nodejs", "harness"],
  "timezone": "browser",
  "schemaVersion": 30,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Event Loop Lag (Detects CPU Hog)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "nodejs_eventloop_lag_seconds",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap Memory Used (Detects Memory Leaker)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "nodejs_heap_size_used_bytes",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active Handles (Detects Socket Hoarder)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "nodejs_active_handles",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(process_cpu_user_seconds_total[1m]) * 100",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}